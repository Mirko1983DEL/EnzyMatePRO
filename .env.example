# Beispielwerte – echte Werte NIE einchecken (.env ist in .gitignore).
PORT=3100
# Eigenes Datenverzeichnis nur für Pro (nicht das von EnzyMate verwenden!)
DATA_DIR=./data
# 32 Byte, 64 Hex-Zeichen: openssl rand -hex 32  (eigener Schlüssel, nicht den von EnzyMate wiederverwenden)
ENZYMATE_PRO_KEY=
# Optional, für Foto-Schätzung (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Auf öffentlichem Server unbedingt setzen
ACCESS_TOKEN=
